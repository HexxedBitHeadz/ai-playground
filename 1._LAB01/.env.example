# Local stack image and port configuration
OLLAMA_IMAGE=ollama/ollama:latest

# Exposed ports
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=8081
CHROMA_PORT=8001

# Models to pull automatically by install.sh.
# Comma-separated. Pull is ~38 GB total — drop entries to slim down, or use
# the dashboard's `./run.sh --lite` flag for a tinyllama+llama3.2:1b subset.
OLLAMA_MODELS=tinyllama:1.1b,llama3.2:1b,llama3.1:8b,mistral:7b,qwen2.5:7b,gemma3:12b,phi4:14b,qwen2.5-coder:7b

# Default model the WebUI loads first. Small + fast gives a snappy first impression;
# users can switch to a larger model in the UI for the heavier walkthroughs.
DEFAULT_MODEL=llama3.2:1b

# Local persistence directories
DATA_DIR=./data
LOG_DIR=./logs
OLLAMA_DATA_DIR=${DATA_DIR}/ollama
CHROMA_DATA_DIR=${DATA_DIR}/chroma
